; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="森林齿轮"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Forest Gear"
run/main_scene="res://levels/test_level.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.055, 0.071, 1)

[autoload]

GameEvents="*res://autoload/game_events.gd"
SceneTransition="*res://autoload/scene_transition.gd"
SaveManager="*res://autoload/save_manager.gd"
GameManager="*res://autoload/game_manager.gd"
SettingsManager="*res://autoload/settings_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
ObjectPool="*res://autoload/object_pool.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=1

